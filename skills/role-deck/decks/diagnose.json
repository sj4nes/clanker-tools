{
  "deck": "diagnose",
  "version": "0.8.0",
  "goal_shape": "Something is wrong and the cause is not known.",
  "_note": "Hand-written first, then corrected by the tooling at every step. v0.1.0 had RED and YELLOW decorative; v0.3.0 added a budget, which cannot be a hard wall; v0.5.0 grounded WHITE and EXECUTE in real instruments; v0.6.0 forced RED before any evidence, after the simulator found the hunch landing AFTER the evidence half the time; v0.7.0 adds weights. Weights shape WHICH optional card is played; only the budget controls HOW MUCH is spent. See FINDINGS.md.",
  "artifacts": {
    "question": {
      "fields": [
        "scope",
        "symptom",
        "stop_condition"
      ]
    },
    "evidence": {
      "fields": [
        "observations",
        "provenance"
      ]
    },
    "hunch": {
      "fields": [
        "gut_call"
      ]
    },
    "hypotheses": {
      "fields": [
        "candidates"
      ],
      "min_items": {
        "candidates": 2
      }
    },
    "support": {
      "fields": [
        "explains"
      ]
    },
    "discriminator": {
      "fields": [
        "test",
        "predicted_outcomes"
      ]
    },
    "result": {
      "fields": [
        "observed"
      ]
    },
    "verdict": {
      "fields": [
        "conclusion",
        "residual_uncertainty",
        "ranking"
      ]
    }
  },
  "required_roles": [
    "WHITE",
    "RED",
    "GREEN",
    "YELLOW",
    "BLACK",
    "EXECUTE"
  ],
  "cards": [
    {
      "id": "open",
      "role": "BLUE",
      "copies": 1,
      "requires": [],
      "produces": "question",
      "instrument": null,
      "brief": "Name the diagnostic question, its scope, and what would end it."
    },
    {
      "id": "gather",
      "role": "WHITE",
      "copies": 2,
      "requires": [
        "question",
        "hunch"
      ],
      "produces": "evidence",
      "instrument": "retrieval",
      "brief": "Observations only. No interpretation, no candidate causes."
    },
    {
      "id": "hunch",
      "role": "RED",
      "copies": 1,
      "requires": [
        "question"
      ],
      "produces": "hunch",
      "instrument": null,
      "brief": "State the gut call in one line, deliberately WITHOUT justification."
    },
    {
      "id": "hypothesize",
      "role": "GREEN",
      "copies": 2,
      "requires": [
        "evidence"
      ],
      "produces": "hypotheses",
      "instrument": null,
      "brief": "At least two competing explanations. Do not rank them."
    },
    {
      "id": "support",
      "role": "YELLOW",
      "copies": 1,
      "requires": [
        "hypotheses"
      ],
      "produces": "support",
      "instrument": null,
      "brief": "What each hypothesis would explain if true. Value before fault."
    },
    {
      "id": "falsify",
      "role": "BLACK",
      "copies": 2,
      "requires": [
        "hypotheses",
        "support"
      ],
      "produces": "discriminator",
      "instrument": null,
      "brief": "A test whose outcome DIFFERS between hypotheses, derived from what each was said to explain. Not a confirmation.",
      "weight": 2.0
    },
    {
      "id": "run",
      "role": "EXECUTE",
      "copies": 2,
      "requires": [
        "discriminator"
      ],
      "produces": "result",
      "instrument": "execution",
      "brief": "Actually run the discriminating test and record what happened. Costs 2: this is the hat that spends real resources.",
      "cost": 2
    },
    {
      "id": "close",
      "role": "BLUE",
      "copies": 1,
      "requires": [
        "result",
        "hunch"
      ],
      "produces": "verdict",
      "instrument": null,
      "terminal": true,
      "brief": "Conclusion, what remains uncertain, and whether the opening hunch was borne out."
    }
  ],
  "budget": 11,
  "rerolls": 2,
  "instrument_kinds": [
    "retrieval",
    "execution"
  ],
  "instrumented_roles": [
    "WHITE",
    "EXECUTE"
  ],
  "expected_order": [
    [
      "hunch",
      "gather"
    ],
    [
      "hunch",
      "hypothesize"
    ],
    [
      "hunch",
      "falsify"
    ],
    [
      "hunch",
      "run"
    ],
    [
      "gather",
      "hypothesize"
    ],
    [
      "support",
      "falsify"
    ],
    [
      "falsify",
      "run"
    ]
  ],
  "repeat_decay": 0.5
}
