continuous_mapping_theorem slutsky_theorem
portmanteau_theorem slutsky_theorem
# WLLN: Chebyshev on the sample mean (finite-variance route), CF route noted.
iid weak_law_large_numbers
chebyshev_inequality weak_law_large_numbers
convergence_in_probability weak_law_large_numbers
variance_of_sum weak_law_large_numbers
expectation_linearity weak_law_large_numbers
characteristic_function weak_law_large_numbers
# SLLN: Etemadi / fourth-moment truncation + BC1 (choice-free).
iid strong_law_large_numbers
convergence_almost_sure strong_law_large_numbers
borel_cantelli_first strong_law_large_numbers
expectation strong_law_large_numbers
variance strong_law_large_numbers
moment strong_law_large_numbers
# Levy continuity: pointwise CF convergence (phi cts at 0) <=> convergence in d.
characteristic_function levy_continuity_theorem
convergence_in_distribution levy_continuity_theorem
cf_properties levy_continuity_theorem
# CLT: expand the CF of the normalised sum, -> e^{-t^2/2}, apply Levy.
iid central_limit_theorem
characteristic_function central_limit_theorem
levy_continuity_theorem central_limit_theorem
convergence_in_distribution central_limit_theorem
standard_normal central_limit_theorem
