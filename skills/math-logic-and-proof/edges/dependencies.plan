# edges/dependencies.plan  --  A B  means: A is a necessary prerequisite for
# correctly stating / proving / interpreting / applying B, within scope.
# Evidence for every edge in the trailing comment. Strip with:
#   grep -Ev '^[[:space:]]*(#|$)' edges/dependencies.plan > edges/dependencies.edges
# Only requires / defines / derives_from / valid_when edges live here.
# generalizes / equivalent_to / dual_of / historically_precedes / mentioned-alternative
# relations live in edges/relations.tsv ; cross-capsule grounds in edges/cross-capsule.md.

## ---- propositional syntax ----
symbol string                       # a string is a finite sequence of symbols
string wff_syntax                   # a wff is a distinguished string
finite_sequence string              # string = finite sequence of symbols
inductive_definition wff_syntax     # wffs given by base (atoms) + closure (connectives) clauses
wff_syntax true_false_constants     # top defined as (p to p); bottom is a wff constant
wff_syntax formula_complexity       # length/height are defined by recursion on the wff
inductive_definition formula_complexity   # recursion clause
wff_syntax wff_unique_readability   # statement is about parses of wffs
formula_complexity wff_unique_readability  # induction on complexity in the proof
wff_syntax subformula               # subformula = node of the wffs parse tree
wff_unique_readability subformula   # well-defined only given unique parse
wff_syntax structural_induction_wff
inductive_definition structural_induction_wff   # it is the induction principle of the wff inductive def
wff_unique_readability structural_induction_wff  # needs one-clause-per-connective, i.e. unique parse
structural_induction_wff recursion_on_wff        # recursion justified by the induction principle
wff_unique_readability recursion_on_wff          # values well-defined only with unique readability

## ---- propositional semantics ----
symbol truth_assignment             # atoms are symbols; assignment maps them
wff_syntax truth_assignment         # assignment is to the atoms of the language
truth_assignment truth_value_recursion
recursion_on_wff truth_value_recursion   # the value function is defined by wff-recursion
true_false_constants truth_value_recursion   # clauses for top/bottom
truth_value_recursion satisfaction
satisfaction truth_table
formula_complexity truth_table      # the table has 2^(number of atoms) rows -- finiteness
truth_table tautology
satisfaction tautology
satisfaction contradiction_unsat
satisfaction satisfiability
satisfaction semantic_consequence
truth_assignment semantic_consequence
semantic_consequence logical_equivalence
satisfaction logical_equivalence
recursion_on_wff substitution_of_equivalents   # replace a subformula: recursion on structure
subformula substitution_of_equivalents
logical_equivalence substitution_of_equivalents
tautology tautology_decidable
truth_table tautology_decidable
decidability tautology_decidable    # the statement is a decidability claim
logical_equivalence duality_principle
de_morgan_prop duality_principle    # duality is proved via De Morgan on the whole formula

## ---- propositional laws (all stated as logical equivalences) ----
logical_equivalence double_negation
logical_equivalence de_morgan_prop
logical_equivalence distributivity_prop
logical_equivalence implication_as_disjunction
logical_equivalence contraposition
logical_equivalence biconditional_as_conjunction
logical_equivalence commutativity_associativity_idempotence
logical_equivalence absorption
logical_equivalence exportation
double_negation contraposition       # contraposition proof route uses DNE for the converse
implication_as_disjunction de_morgan_prop   # not(p and q) via not(p and q) = p -> not q

## ---- normal forms & expressive completeness ----
de_morgan_prop negation_normal_form
double_negation negation_normal_form
implication_as_disjunction negation_normal_form   # eliminate -> and <-> first
recursion_on_wff negation_normal_form
negation_normal_form conjunctive_normal_form
distributivity_prop conjunctive_normal_form
negation_normal_form disjunctive_normal_form
distributivity_prop disjunctive_normal_form
truth_table dnf_from_truth_table
disjunctive_normal_form dnf_from_truth_table
dnf_from_truth_table functional_completeness   # DNF from the table expresses any Boolean function
truth_table binary_boolean_functions_16
functional_completeness sheffer_stroke
de_morgan_prop sheffer_stroke        # express not, and, or from nand
binary_boolean_functions_16 sheffer_stroke

## ---- propositional deduction: natural deduction ----
wff_syntax nd_rules_propositional
finite_sequence nd_derivation
wff_syntax nd_derivation
nd_rules_propositional nd_derivation
inductive_definition nd_derivation   # derivations inductively generated by the rules
nd_rules_propositional assumption_discharge   # ->I is the discharging rule
nd_derivation assumption_discharge
true_false_constants explosion_ex_falso       # bottom-elimination
nd_rules_propositional explosion_ex_falso
nd_derivation raa_rule
true_false_constants raa_rule
double_negation raa_rule              # RAA is inter-derivable with DNE -- classical

## ---- propositional deduction: Hilbert ----
wff_syntax hilbert_system_prop
wff_syntax modus_ponens
modus_ponens hilbert_system_prop
finite_sequence hilbert_derivation
hilbert_system_prop hilbert_derivation
inductive_definition hilbert_derivation
hilbert_derivation deduction_theorem
modus_ponens deduction_theorem
metatheoretic_induction deduction_theorem   # induction on the length of the Hilbert derivation

## ---- derivability (calculus-independent) & the equivalence ----
nd_derivation nd_hilbert_equivalence
hilbert_derivation nd_hilbert_equivalence
deduction_theorem nd_hilbert_equivalence    # ND ->I simulated in Hilbert via the deduction theorem
assumption_discharge nd_hilbert_equivalence
nd_hilbert_equivalence derivability          # 'Gamma proves phi' is calculus-independent once these coincide
nd_derivation derivability
hilbert_derivation derivability
derivability derived_rules
raa_rule derived_rules                       # MT, disjunctive syllogism need the classical rule
modus_ponens derived_rules

## ---- propositional metatheory ----
derivability consistency
true_false_constants consistency
derivability soundness_prop
semantic_consequence soundness_prop
nd_rules_propositional soundness_prop         # induction over the rules: each preserves truth
structural_induction_wff soundness_prop       # (induction on the derivation)
consistency maximal_consistent_set
maximal_consistent_set lindenbaum_lemma_prop
consistency lindenbaum_lemma_prop
metatheoretic_induction lindenbaum_lemma_prop  # enumerate wffs, decide each in turn
derivability lindenbaum_lemma_prop
maximal_consistent_set truth_lemma_prop
truth_assignment truth_lemma_prop
derivability truth_lemma_prop
de_morgan_prop truth_lemma_prop               # the MCS respects the connective clauses (uses classical laws)
lindenbaum_lemma_prop post_completeness_theorem
truth_lemma_prop post_completeness_theorem
soundness_prop post_completeness_theorem      # stated as the converse of soundness
semantic_consequence post_completeness_theorem
consistency post_completeness_theorem
post_completeness_theorem compactness_prop    # compactness as a corollary of finite-derivation + completeness
derivability compactness_prop                 # a derivation uses only finitely many premises
satisfiability compactness_prop
soundness_prop compactness_prop

## ---- first-order syntax ----
symbol signature
inductive_definition signature               # arities are metatheoretic naturals
metatheoretic_induction signature
signature term_syntax
inductive_definition term_syntax
term_syntax atomic_formula
signature atomic_formula
first_order_logic_with_equality atomic_formula   # equality is an always-present atomic form
symbol quantifier_syntax                      # the quantifier symbols and the bound variable
wff_syntax first_order_wff                    # connective closure carried over
atomic_formula first_order_wff
quantifier_syntax first_order_wff
inductive_definition first_order_wff
first_order_wff free_bound_variables
quantifier_syntax free_bound_variables        # 'bound' = under a quantifier on that variable
recursion_on_wff free_bound_variables         # FV defined by recursion (same principle, FOL wffs)
free_bound_variables sentence
term_syntax substitution
first_order_wff substitution
free_bound_variables substitution             # substitute for FREE occurrences only
recursion_on_wff substitution
free_bound_variables free_for
quantifier_syntax free_for
term_syntax free_for                           # capture is about the free variables of t vs quantifiers of phi
# NB: substitution (the total syntactic operation) and free_for are INDEPENDENT;
# every node that *substitutes under a binder* (substitution_lemma_semantic,
# nd_rules_quantifier, hilbert_quantifier_axioms, prenex_normal_form) requires BOTH.
free_bound_variables alpha_equivalence
substitution alpha_equivalence
free_for alpha_equivalence
first_order_wff prenex_normal_form
alpha_equivalence prenex_normal_form          # rename bound vars to pull quantifiers out
quantifier_negation prenex_normal_form        # move negation past quantifiers
free_for prenex_normal_form

