/* Graphical-integrity + accessibility arithmetic for the visualization-design
 * skill.  Run:  bc -l -q skills/visualization-design/verification/checks.bc
 *
 * bc -l gives e() and l(); identifiers are lowercase, letters/digits only,
 * no '_' and no single uppercase letters (per the `bc` skill).
 * bc truncates -- scale set explicitly.
 *
 * EVERY CLAIM IS ASSERTED (helpers below): `bc`'s `quit` always exits 0, so a
 * printed "(want >= 4.5)" catches nothing.  Corrupting the contrast formula
 * used to print "black on white = 2.05  (want >= 4.5)" and still pass.
 * See docs/bc-verification-audit.md.
 */
scale = 8

/* --- assertion helpers -------------------------------------------------
 * Every claim below is ASSERTED, not merely annotated: a wrong value prints
 * a FAIL line and run.sh greps for it.  `bc`'s `quit` ALWAYS exits 0, so the
 * exit status can never signal failure.  See docs/bc-verification-audit.md.
 * `abs` is reserved in macOS bc, hence `aval`; BSD bc functions take numeric
 * arguments only, so the message is printed at the call site.
 */
define aval(x) {
  if (x < 0) { return (-x) }
  return (x)
}
define chk(claim, tol) {      /* 1 on FAILURE, else 0 */
  if (aval(claim) <= tol) { return (0) }
  return (1)
}
define neg(x) {               /* 1 if x < 0, i.e. an "x >= 0" claim failed */
  if (x >= 0) { return (0) }
  return (1)
}
fails = 0
bad = 0
tol = 0.0001

/* ---- WCAG relative luminance and contrast ratio -------------------------- */

/* sRGB channel (0..1) -> linear light */
define chan(c) {
    if (c <= 0.03928) return (c / 12.92)
    return e(2.4 * l((c + 0.055) / 1.055))
}

/* relative luminance of an sRGB colour given 0..255 components */
define lum(r, g, b) {
    return 0.2126 * chan(r/255) + 0.7152 * chan(g/255) + 0.0722 * chan(b/255)
}

/* contrast ratio between two luminances, order-independent */
define contrast(la, lb) {
    if (la >= lb) return (la + 0.05) / (lb + 0.05)
    return (lb + 0.05) / (la + 0.05)
}

print "=== WCAG contrast ratios ===\n"

/* near-black text on white: must clear 4.5 (body) and 3 (large) */
lblack = lum(0, 0, 0)
lwhite = lum(255, 255, 255)
cbw = contrast(lblack, lwhite)
print "black on white          = ", cbw, "  (claim: = 21, the WCAG maximum)\n"
/* 21:1 is the theoretical maximum contrast ratio, (1+.05)/(0+.05).  Asserting
   the exact value pins the whole luminance pipeline: chan(), lum(), and
   contrast() must all be right to land on it. */
bad = chk(cbw - 21, tol); if (bad) { print "*** FAIL: black on white = 21 (the WCAG maximum)\n" }
fails += bad
bad = neg(cbw - 4.5); if (bad) { print "*** FAIL: black on white must clear the 4.5 body-text threshold\n" }
fails += bad

/* a mid grey (#767676) on white -- the classic 4.5:1 boundary */
lgrey = lum(118, 118, 118)
cgw = contrast(lgrey, lwhite)
print "#767676 on white        = ", cgw, "  (claim: >= 4.5, the boundary grey)\n"
/* #767676 is the classic just-passing grey: it clears 4.5 by a hair (4.542).
   Assert BOTH that it passes and that it is genuinely near the boundary --
   a formula error that inflated all ratios would otherwise slip through. */
bad = neg(cgw - 4.5); if (bad) { print "*** FAIL: #767676 on white must clear 4.5\n" }
fails += bad
bad = neg(4.7 - cgw); if (bad) { print "*** FAIL: #767676 must sit NEAR the 4.5 boundary (< 4.7)\n" }
fails += bad

/* red vs green as the ONLY cue: #d62728 vs #2ca02c (matplotlib tab10).
 * Their mutual contrast is low -> fails as a standalone distinction. */
lred = lum(214, 39, 40)
lgreen = lum(44, 160, 44)
crg = contrast(lred, lgreen)
print "tab10 red vs green      = ", crg, "  (claim: < 3 -> FAILS as a standalone cue)\n"
/* THE NEGATIVE CONTRAST of this section: red/green alone does NOT separate.
   The guardrail is only meaningful if this genuinely falls short of 3, so
   assert the FAILURE rather than printing the word "FAILS". */
bad = neg(3 - crg); if (bad) { print "*** FAIL: red vs green must FALL SHORT of 3 (that is the point of the guardrail)\n" }
fails += bad

/* two adjacent categorical fills that DO separate: tab10 blue vs orange */
lblue = lum(31, 119, 180)
lorange = lum(255, 127, 14)
cbo = contrast(lblue, lorange)
print "tab10 blue vs orange    = ", cbo, "  (claim: separates better than red/green)\n"
/* Blue/orange is the recommended pair, and must beat red/green -- the ordering
   is the actionable claim, not either number alone. */
bad = neg(cbo - crg); if (bad) { print "*** FAIL: blue/orange must separate better than red/green\n" }
fails += bad

/* ---- Tufte lie factor / proportional-distortion ratio ------------------- */

print "\n=== Proportional-distortion (lie factor) ===\n"

/* Lie factor = (relative size of effect shown) / (relative size in data).
 * Honest chart -> 1. */

/* Case A: truncated bar chart. Data 96 vs 100 (a 4/96 = 4.17% increase).
 * Axis runs 90..100, so bar pixel heights are (96-90)=6 vs (100-90)=10.
 * Shown increase = 4/6 = 66.7%. */
datachange = (100 - 96) / 96
shownchange = (10 - 6) / 6
lfa = shownchange / datachange
print "truncated bar lie factor = ", lfa, "  (claim: ~16 => gross distortion)\n"
bad = chk(lfa - 16, 0.001); if (bad) { print "*** FAIL: truncated-bar lie factor = 16\n" }
fails += bad
/* Tufte's threshold: |lie factor - 1| > 0.05 is a distortion.  Assert this one
   is far past it, in the direction of EXAGGERATION. */
bad = neg(lfa - 1.05); if (bad) { print "*** FAIL: a truncated axis must exaggerate (lie factor > 1.05)\n" }
fails += bad

/* Case B: value doubles (1 -> 2) but is drawn as an icon scaled in BOTH
 * width and height, so displayed AREA goes 1 -> 4. */
datachangeb = (2 - 1) / 1
shownchangeb = (4 - 1) / 1
lfb = shownchangeb / datachangeb
print "area-for-length lie factor = ", lfb, "  (claim: 3 => a doubled value looks 4x)\n"
bad = chk(lfb - 3, tol); if (bad) { print "*** FAIL: area-for-length lie factor = 3\n" }
fails += bad
bad = neg(lfb - 1.05); if (bad) { print "*** FAIL: scaling both dimensions must exaggerate\n" }
fails += bad

/* Case C: honest bar from zero, 96 vs 100.  The POSITIVE control.
 *
 * NOTE (2026-09-13): this check was VACUOUS -- `shownc` and `datac` were the
 * same expression, so the ratio was 1 by construction and would have printed 1
 * for any wrong rendering rule.  The shown change is now computed from PIXEL
 * HEIGHTS measured off a zero baseline, by its own route, so the ratio
 * genuinely tests that a zero-baseline bar is undistorted. */
pixlo = 96 - 0          /* bar height with the axis at zero */
pixhi = 100 - 0
shownc = (pixhi - pixlo) / pixlo
datac  = (100 - 96) / 96
lfc = shownc / datac
print "zero-baseline bar lie factor = ", lfc, "  (claim: exactly 1 = honest)\n"
bad = chk(lfc - 1, tol); if (bad) { print "*** FAIL: a zero-baseline bar must have lie factor 1\n" }
fails += bad
/* Tufte's tolerance band, asserted on the honest case. */
bad = neg(0.05 - aval(lfc - 1)); if (bad) { print "*** FAIL: the honest case must sit inside Tufte's +-0.05 band\n" }
fails += bad

print "\n"
if (fails == 0) {
  print "ALL BC CHECKS PASSED\n"
}
if (fails > 0) {
  print "*** ", fails, " BC CHECK(S) FAILED\n"
}
quit
