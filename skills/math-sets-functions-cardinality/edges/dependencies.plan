# --- The natural numbers from sets ----------------------------------

set omega_construction
axiom_infinity omega_construction
axiom_separation omega_construction
empty_set omega_construction
binary_union_intersection omega_construction
omega_construction finite_ordinal
# (omega, 0, S) satisfies the Peano axioms -- discharges math-number-systems.
omega_construction peano_holds_in_omega
axiom_infinity peano_holds_in_omega
axiom_extensionality peano_holds_in_omega
# Recursion on omega, proved directly (also a special case of transfinite_recursion).
peano_holds_in_omega recursion_theorem
omega_construction recursion_theorem
function recursion_theorem
axiom_separation recursion_theorem
# Pigeonhole: induction on n that no injection [n+1] -> [n] exists.
finite_ordinal pigeonhole_principle
injection pigeonhole_principle
omega_construction pigeonhole_principle
quantifier_negation pigeonhole_principle

# --- Cardinality --------------------------------------------------

bijection equinumerous
injection cardinal_le
cardinal_le cardinal_lt
equinumerous cardinal_lt
quantifier_negation cardinal_lt
# Cantor-Schroeder-Bernstein: injections both ways -> a bijection.  NO CHOICE.
cardinal_le cantor_schroeder_bernstein
bijection cantor_schroeder_bernstein
function_composition cantor_schroeder_bernstein
# Cantor: the set { x : x not in f(x) } defeats any f : X -> P(X).  NO CHOICE.
surjection cantor_theorem
power_set cantor_theorem
cardinal_lt cantor_theorem
quantifier_negation cantor_theorem
# Finite / infinite / Dedekind-infinite.
equinumerous finite_set
finite_ordinal finite_set
omega_construction finite_set
finite_set infinite_set
quantifier_negation infinite_set
equinumerous dedekind_infinite
subset dedekind_infinite
quantifier_negation dedekind_infinite
infinite_set finite_iff_not_dedekind_infinite
dedekind_infinite finite_iff_not_dedekind_infinite
countable_choice finite_iff_not_dedekind_infinite
injection finite_iff_not_dedekind_infinite
# Countable = injects into omega.
injection countable_set
omega_construction countable_set
# omega x omega is countable: a lexicographic-by-max well-order of type omega.
omega_construction nat_times_nat_countable
order_type_theorem nat_times_nat_countable
well_order nat_times_nat_countable
cartesian_product nat_times_nat_countable
bijection nat_times_nat_countable
# Closure: subsets, images, finite products, countable unions (last needs CC).
countable_set countable_closure_properties
nat_times_nat_countable countable_closure_properties
countable_choice countable_closure_properties
image countable_closure_properties
cartesian_product countable_closure_properties
# Uncountable = infinite and not countable.
countable_set uncountable_set
infinite_set uncountable_set
quantifier_negation uncountable_set
# The diagonal argument: 2^omega is uncountable (Cantor's theorem at omega).
cantor_theorem cantor_diagonal
powerset_iso_two_power cantor_diagonal
omega_construction cantor_diagonal
countable_set cantor_diagonal
quantifier_negation cantor_diagonal
# |P(omega)| = |2^omega| = |R| (R imported; the equinumerosity uses CSB).
cantor_schroeder_bernstein powerset_nat_equinumerous_reals
powerset_iso_two_power powerset_nat_equinumerous_reals
omega_construction powerset_nat_equinumerous_reals
# Comparability of cardinals -- needs AC (via well-ordering + order types).
cardinal_le cardinal_comparability
well_ordering_theorem cardinal_comparability
order_type_theorem cardinal_comparability
axiom_of_choice cardinal_comparability
# Arithmetic of infinite cardinals.
nat_times_nat_countable infinite_cardinal_arithmetic
countable_closure_properties infinite_cardinal_arithmetic
cardinal_comparability infinite_cardinal_arithmetic
zorn_lemma infinite_cardinal_arithmetic
well_order infinite_cardinal_arithmetic
# Hartogs: a well-ordered cardinal not injecting into X.  NO CHOICE.
ordinal hartogs_number
well_order hartogs_number
order_type_theorem hartogs_number
cardinal_le hartogs_number
power_set hartogs_number
axiom_replacement hartogs_number
quantifier_negation hartogs_number
# The aleph hierarchy.
hartogs_number aleph_hierarchy
ordinal aleph_hierarchy
transfinite_recursion aleph_hierarchy
well_ordering_theorem aleph_hierarchy
cardinal_comparability aleph_hierarchy
# The continuum.
cantor_diagonal continuum
powerset_nat_equinumerous_reals continuum
aleph_hierarchy continuum
# CH: no cardinal strictly between aleph0 and 2^aleph0 -- independent of ZFC.
continuum continuum_hypothesis
aleph_hierarchy continuum_hypothesis
cardinal_lt continuum_hypothesis
