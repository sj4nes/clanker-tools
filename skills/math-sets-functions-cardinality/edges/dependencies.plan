subset bounds_extrema
total_order chain_antichain
subset chain_antichain
partial_order maximal_element
total_order well_order
bounds_extrema well_order
# Zorn: a chain-bounded poset has a maximal element (equivalent to AC).
partial_order zorn_lemma
chain_antichain zorn_lemma
maximal_element zorn_lemma
bounds_extrema zorn_lemma
axiom_of_choice zorn_lemma
# Well-ordering theorem, proved via Zorn on partial well-orders.
well_order well_ordering_theorem
zorn_lemma well_ordering_theorem
axiom_of_choice well_ordering_theorem
# The summary equivalence node.
axiom_of_choice ac_equivalences
zorn_lemma ac_equivalences
