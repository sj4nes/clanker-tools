cardinal_comparability ac_equivalences

# --- Ordinal spine ------------------------------------------------

set ordinal
well_order ordinal
axiom_foundation ordinal
axiom_separation ordinal
ordinal transfinite_induction
axiom_foundation transfinite_induction
transfinite_induction transfinite_recursion
ordinal transfinite_recursion
function transfinite_recursion
axiom_replacement transfinite_recursion
well_order order_type_theorem
