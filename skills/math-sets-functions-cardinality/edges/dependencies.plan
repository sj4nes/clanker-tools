# =============================================================================
# Release 0.1 prerequisite edges.  "A B" means A is a necessary prerequisite for
# correctly stating / proving / using B.  The preceding `#` comment is the
# evidence.  validation/graph-check.sh strips comments to
# edges/dependencies.edges.  Equivalences live in edges/relations.tsv.
# =============================================================================

# --- Logic floor ---------------------------------------------------------

# Quantifiers are built on propositional connectives.
proposition_logic predicate_logic
# The proof strategies are propositional (classical) reasoning.
proposition_logic proof_methods
# Quantifier negation is classical: not-forall unfolds to exists-not.
predicate_logic quantifier_negation
proof_methods quantifier_negation
# Quantifier order is a fact about nested quantifiers.
predicate_logic quantifier_order

# --- The ZF(C) axioms --------------------------------------------------

# Each axiom is a sentence of predicate logic; extensionality fixes what "set" means.
predicate_logic axiom_extensionality
# Uniqueness of the empty set, of pairs, of unions, of power sets is extensionality.
axiom_extensionality axiom_empty_set
axiom_extensionality axiom_pairing
axiom_extensionality axiom_union
axiom_extensionality axiom_power_set
# Separation and replacement are schemas -- one instance per formula.
predicate_logic axiom_separation
predicate_logic axiom_replacement
# An inductive set contains the empty set and is successor-closed.
predicate_logic axiom_infinity
axiom_empty_set axiom_infinity
# Foundation forbids infinite descending membership chains.
predicate_logic axiom_foundation
# Choice: a selector for a family of nonempty sets.
predicate_logic axiom_of_choice
# The ZF bundle, then ZFC.
axiom_extensionality zf
axiom_empty_set zf
axiom_pairing zf
axiom_union zf
axiom_power_set zf
axiom_separation zf
axiom_replacement zf
axiom_infinity zf
axiom_foundation zf
zf zfc
axiom_of_choice zfc
# Choice implies dependent choice implies countable choice.
axiom_of_choice dependent_choice
dependent_choice countable_choice

# --- Set algebra ------------------------------------------------------

# A set is an element of a model of ZF (choice not needed to have sets).
zf set
# The named sets.
set empty_set
axiom_empty_set empty_set
axiom_extensionality empty_set
set subset
axiom_extensionality subset
axiom_power_set power_set
subset power_set
# Binary union/intersection from pairing + union + separation.
set binary_union_intersection
axiom_pairing binary_union_intersection
axiom_union binary_union_intersection
axiom_separation binary_union_intersection
# Union / intersection of an arbitrary family (intersection needs nonempty).
set family_union_intersection
axiom_union family_union_intersection
axiom_separation family_union_intersection
# Difference and complement.
set set_difference
axiom_separation set_difference
set_difference relative_complement
# De Morgan's laws ARE quantifier negation, applied to membership.
family_union_intersection de_morgan_laws
relative_complement de_morgan_laws
quantifier_negation de_morgan_laws
# Distributivity of cap over an arbitrary union.
family_union_intersection distributive_laws
binary_union_intersection distributive_laws
# Ordered pairs (Kuratowski) and products.
set ordered_pair
axiom_pairing ordered_pair
axiom_extensionality ordered_pair
ordered_pair cartesian_product
power_set cartesian_product
axiom_separation cartesian_product
cartesian_product disjoint_union
binary_union_intersection disjoint_union

# --- Relations -------------------------------------------------------

cartesian_product relation
subset relation
relation domain_range
axiom_union domain_range
relation relation_composition_inverse
cartesian_product relation_composition_inverse
relation relation_properties
relation relation_restriction

# --- Functions ------------------------------------------------------

relation function
domain_range function
function injection
function surjection
injection bijection
surjection bijection
# Image and preimage.
function image
axiom_separation image
axiom_replacement image
function preimage
axiom_separation preimage
# An indexed family is a function; indexed union/intersection follow.
function indexed_family
indexed_family indexed_union_intersection
family_union_intersection indexed_union_intersection
# THE preimage algebra: f^{-1} commutes with union, intersection, complement.
# The proofs are elementwise and are exactly quantifier manipulation.
preimage preimage_algebra
indexed_union_intersection preimage_algebra
relative_complement preimage_algebra
quantifier_negation preimage_algebra
# Image laws (weaker for intersection).
image image_algebra
indexed_union_intersection image_algebra
# Composition, identity, inverse.
function function_composition
function identity_function
bijection inverse_function
function_composition inverse_function
identity_function inverse_function
inverse_function inverse_iff_bijective
bijection inverse_iff_bijective
# One-sided inverses: left <-> injective (choice-free); right <-> surjective (AC).
injection left_inverse_iff_injective
inverse_function left_inverse_iff_injective
identity_function left_inverse_iff_injective
surjection right_inverse_iff_surjective
inverse_function right_inverse_iff_surjective
axiom_of_choice right_inverse_iff_surjective
# Composites of injections/surjections/bijections.
injection composition_preserves_properties
surjection composition_preserves_properties
bijection composition_preserves_properties
function_composition composition_preserves_properties
# Function spaces and characteristic functions.
function function_space
power_set function_space
cartesian_product function_space
function characteristic_function
image characteristic_function
empty_set characteristic_function
# P(X) is isomorphic to 2^X via A -> 1_A.
characteristic_function powerset_iso_two_power
power_set powerset_iso_two_power
function_space powerset_iso_two_power
bijection powerset_iso_two_power

