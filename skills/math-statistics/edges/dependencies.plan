# edges/dependencies.plan  --  math-statistics Release 0.1
# Format: one "A B" edge per non-comment line; A is a necessary prerequisite for
# correctly stating / proving / interpreting / applying B, within scope.
# Non-prerequisite relations (generalizes, equivalent_to, special_case_of, ...)
# live in edges/relations.tsv, NOT here.
#
# Roots (no incoming edges): every prob_*, ra_*, and linear_algebra_background
# node -- cited into math-probability / math-real-analysis (see conventions.md).

# ===========================================================================
# 1. The statistical model and the likelihood
# ===========================================================================
# a model is a family of probability laws; needs the notion of a law.
prob_probability_space statistical_model
# parametric = the index set is finite-dimensional.
statistical_model parametric_model
parametric_model parameter_space
# identifiability is a property of the map theta -> P_theta.
parametric_model identifiability
# a dominated family is defined via densities against a common measure.
prob_pdf dominated_family
statistical_model dominated_family
# an iid sample is n independent draws from one member of the model.
prob_iid iid_sample
statistical_model iid_sample
# a statistic is a function of the sample.
iid_sample statistic
# the likelihood is the joint density read as a function of theta.
dominated_family likelihood_function
iid_sample likelihood_function
prob_joint_distribution likelihood_function
# log-likelihood, score, information are successive derivatives of L.
likelihood_function log_likelihood
log_likelihood score_function
ra_differentiability score_function
# Fisher information is the variance of the score.
score_function fisher_information
prob_variance fisher_information
score_function fisher_information_matrix
prob_covariance fisher_information_matrix
linear_algebra_background fisher_information_matrix
# the score identity: differentiate int f = 1 under the integral sign.
score_function score_identity
interchange_derivative_integral score_identity
support_independent_of_theta score_identity
prob_expectation score_identity
# information equality: differentiate the score identity once more.
score_identity information_equality
fisher_information information_equality
interchange_derivative_integral information_equality
log_likelihood_smooth information_equality
# regularity hypotheses attach to the results that need them (below); they are
# themselves defined against the density and the parameter space.
dominated_family support_independent_of_theta
dominated_family interchange_derivative_integral
parameter_space true_parameter_interior
fisher_information_matrix fisher_information_positive_definite
log_likelihood log_likelihood_smooth
parametric_model identifiability

